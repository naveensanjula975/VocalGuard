# ─────────────────────────────────────────────────────────────────────────────
# VocalGuard Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real credentials.
#
#   cp .env.example .env
#
# ⚠️ WARNING: Never commit the actual `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# --- [ 1. Firebase Configuration ] ---
# Get this from Project Settings > General > Your apps > Web API Key
FIREBASE_WEB_API_KEY=your_firebase_api_key_here

# --- [ 2. API Server Configuration ] ---
# The environment the app is running in (development, staging, production)
APP_ENV=development

# The port the API will listen on
PORT=8000

# --- [ 3. Security & CORS ] ---
# Comma-separated list of allowed origins. Use "*" for all in dev.
# In production, set this to your frontend URL (e.g. https://vocalguard.app)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- [ 4. Model Configuration ] ---
# Optional: Override default model versions if needed
# MODEL_VERSION=3.0.0

# --- [ 5. Logging ] ---
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
