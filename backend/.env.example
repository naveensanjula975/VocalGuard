# ─────────────────────────────────────────────────────────────────────────────
# VocalGuard Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your real credentials.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# ─────────────────────────────────────────────────────────────────────────────


# ─── 1. Firebase — REQUIRED ───────────────────────────────────────────────────
# Web API Key — Project Settings > General > Your apps > Web API Key
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here


# ─── 2. API Server ────────────────────────────────────────────────────────────
# Environment identifier (development | staging | production)
APP_ENV=development

# Port the uvicorn server will bind to
PORT=8000


# ─── 3. Security & CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Development — allow the Vite dev server:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production — replace with your real URL:
# ALLOWED_ORIGINS=https://vocalguard.app


# ─── 4. Model Configuration ───────────────────────────────────────────────────
# Override the model version string surfaced in API responses.
# Default is set in config.py. Only override if loading a custom checkpoint.
# MODEL_VERSION=3.0.0

# Ensemble blend weights (must sum to 1.0).
# Use automl_tuning.py to find the optimal values for your dataset.
# Defaults are set in config.py — uncomment only to override.
# ENSEMBLE_WAV2VEC2_WEIGHT=0.6
# ENSEMBLE_TRANSFORMER_WEIGHT=0.4

# Path to model weights directory (defaults to backend/models/deepfake_audio_model).
# Override if loading from a custom location.
# MODEL_DIR=/absolute/path/to/model/directory


# ─── 5. Logging ───────────────────────────────────────────────────────────────
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally, INFO or WARNING in production.
LOG_LEVEL=INFO


# ─── 6. Rate Limiting ─────────────────────────────────────────────────────────
# Controls per-endpoint request throttling (slowapi).
# Format: "<count>/<period>"  e.g. "10/minute", "100/hour"
# Defaults are hardcoded in routes/*.py — set here to override at runtime.
# ANALYSES_RATE_LIMIT=5/minute
# EXPLAIN_RATE_LIMIT=10/minute


# ─── 7. Optional — Firebase Storage ──────────────────────────────────────────
# Required only if you store audio files in Cloud Storage (not the default).
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com


# ─── 8. Optional — Async Webhooks ────────────────────────────────────────────
# Default timeout for webhook delivery (seconds).
# WEBHOOK_TIMEOUT_SEC=10
