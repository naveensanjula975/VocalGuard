# Firebase configuration
# Replace these values with your actual Firebase credentials
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# You can find this value in your Firebase project console:
# FIREBASE_WEB_API_KEY: Project settings > General > Web API Key

# NOTE: You also need to place your Firebase Admin SDK serviceAccountKey.json file in one of these locations:
#   - backend/config/serviceAccountKey.json
#   - or backend/serviceAccountKey.json
# You can download this file from: Project settings > Service accounts > Firebase Admin SDK > Generate new private key

# Optional configuration
# MODEL_PATH=/path/to/custom/model.pth
